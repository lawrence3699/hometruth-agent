# 复制为 .env 后填写。.env 已被 gitignore，永远不要提交真实密钥，也不要把 key 发到群文件里。
# Zetaris：队友建的 Cloud 实例；字段名和 zetaris/getting-started 的 .env.example 一致
ZETARIS_REST_URL=https://api.<tenant>.cloud.zetaris.com/api/v1.0
ZETARIS_BASE_URL=https://new-ui.<tenant>.cloud.zetaris.com
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_USER_AGENT=synapse-hack <your-email>
# NVIDIA build.nvidia.com（右上角生成 key，nvapi- 开头；直连回退和语音链共用这一个 key）
NVIDIA_API_KEY=
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_VL_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# NVIDIA 语音（Pipecat 版 src/voice/pipecat_app.py 用）。默认值就能用；NVIDIA 重新部署导致 function id 变了，去模型页抄新的改这里
NVIDIA_RIVA_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_ASR_FUNCTION_ID=1598d209-5e27-4d3c-8079-4751568b1081
NVIDIA_ASR_MODEL=parakeet-ctc-1.1b-asr   # 只用于界面显示：Pipecat 发请求时 model 留空，由 function id 决定模型
# 换成 Pipecat 默认的 Nemotron 流式识别：NVIDIA_ASR_FUNCTION_ID=bb0837de-8c7b-481f-9ec8-ef5663e9c1fa，NVIDIA_ASR_MODEL=nemotron-asr-streaming
MAGPIE_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
MAGPIE_MODEL=magpie-tts-multilingual
MAGPIE_VOICE=Magpie-Multilingual.EN-US.Aria
MAGPIE_LANGUAGE=en-US
# Pipecat 版合成按句缓存 + 固定话预热（runs/tts_cache/magpie）；0 关掉
MAGPIE_TTS_CACHE=1

# 嘴（合成）用谁：magpie（默认，NVIDIA Riva，用上面那把 NVIDIA key）或 elevenlabs（第三方付费 API，要下面的 key）。
# 只影响 8631 的声音；识别（Parakeet）、脑子（Nemotron 经 Nightshift）、Zetaris 取证都不变。赛事规则允许付费 API，交付时要声明。
TTS_PROVIDER=magpie
# ElevenLabs：elevenlabs.io 注册 → 右上角头像 → API Keys → Create。权限至少勾 Text to Speech + Voices(读) + Models(读)；User(读) 只用来在 --check / --list 里显示额度，不勾也能用。免费档每月 1 万字符，够录对比；正式演示建议 Starter 起
ELEVENLABS_API_KEY=
# 声音：名字或 voice_id 都行，启动时用 /v1/voices 换成 id；全部名单：.venv/bin/python scripts/voice_candidates.py --list
# 10-26 起用 Sarah（女声）；Charlie 是澳洲口音男声；女声候选对比 runs/recordings/voices/female.m4a（Sarah / Bella / Matilda / Jessica / Alice / Lily）
ELEVENLABS_VOICE=Sarah
# 模型：eleven_v4_turbo（默认）= 最有情绪、低延迟、认句首情绪标签，走 HTTP 流式（首字节约 0.45 s）；eleven_flash_v2_5 = 最快但语气平（WebSocket）；
#   eleven_v3_conversational = 也认标签、略慢；eleven_multilingual_v2 = 认 STYLE、不认标签
ELEVENLABS_MODEL=eleven_v4_turbo
# 情绪标签（src/voice/tone.py）：auto = 模型认（v3/v4）就按这句话在流程里的位置加 [thoughtful] / [happy] / [curious]…，只进嘴、不进字幕；0 关
ELEVENLABS_TAGS=auto
# 声音参数，留空 = ElevenLabs 默认。STABILITY 0–1（v3/v4：0 最放得开、0.5 自然、1 最稳）；SIMILARITY 0–1；STYLE 0–1（只有 multilingual_v2 认）；SPEED 0.7–1.2；SPEAKER_BOOST 1/0
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY=
ELEVENLABS_STYLE=
ELEVENLABS_SPEED=
# 说几个词才算打断：0 = 一出声就停（噪声、"嗯"、回声会自动接着播）；吵的地方可设 2
VOICE_INTERRUPT_MIN_WORDS=0
PIPECAT_PORT=8631
# 只在跨机器、跨网络连时才需要，本机不用：PIPECAT_ICE_SERVERS=stun:stun.l.google.com:19302
# Meterless 本地引擎（Nightshift）。地址和 token 都从 Nightshift 右上 Console 复制；token 不是 NVIDIA key
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
# 演示用钉死这条路由（实测经 Nightshift 0.4 s；meterless/auto 在本地 Llama 车道跑着时要 3 s，车道停了才 0.5 s）；想让 Nightshift 自己选再改回 meterless/auto
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_API_KEY=
# 也可以整条粘 Console 的连接链接（http://host:port/connect#k=...），自动拆出地址和 token：METERLESS_CONNECT_LINK=
# token 可以不填，改为读 Nightshift 写在磁盘上的 token 文件（Mac M1-M4 版叫 runtime-token，每次启动可能换；M5+/DGX 叫 proxy-token）：
METERLESS_TOKEN_FILE=~/Library/Application Support/ai.meterless.nightshift.m1m4/runtime-token
# 模型层：auto（Nightshift 优先 → 直连 NVIDIA → 无）、meterless、nvidia、none
LLM_PROVIDER=auto
# 需求解析：auto（有模型就用模型、规则校验兜底）或 rules（只用规则）；模型超时秒数
NEEDS_PARSER=auto
# 需求解析等模型最多几秒，超过退回规则（实测钉死路由 0.7–1.2 s，偶尔 1.7 s；5 s 兜得住尾部又不至于卡死演示）
NEEDS_LLM_TIMEOUT=5
# 反问句用模型润色，默认关；开了也只在校验通过时替换模板句
POLISH_LLM=0
# 台词交给模型写（10-25）：auto = 有模型就让 Nemotron 把每句导览 / 答问 / 确认写得像人，规则逐句审（数字、状态词、维度词），不过审用模板；0 = 全模板
NARRATION_LLM=auto
# 一套房的台词等模型最多几秒（开查时就发出去，讲到时才取；超过就照模板说）
NARRATION_LLM_TIMEOUT=6
# Pipecat 版轮次检测：1 = smart-turn v3 听语调判断“说完了”（本机 CPU，随 pipecat 自带模型）；0 = 固定静音 0.6 s
SMART_TURN=1
# 模型拿不准时最多等多久的静音就算说完（秒）
SMART_TURN_STOP_SECS=1.2
# 自用数据库
DATABASE_URL=postgresql://hometruth:CHANGE_ME@127.0.0.1:5434/hometruth
# 合成数据生成
GEN_MODEL=claude
GEN_SEED=20261024

# 我们自己的 S3 桶（首版数据源：CSV）。只读密钥，只给这一个桶的 GetObject + ListBucket。
AWS_S3_BUCKET=hometruth-data
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID_RO=
AWS_SECRET_ACCESS_KEY_RO=
